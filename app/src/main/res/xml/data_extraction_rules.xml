<?xml version="1.0" encoding="utf-8"?>
<!--
    Aplikasi rekam medis: data kesehatan dan token tidak boleh ikut backup cloud
    maupun transfer perangkat (Android 12+). Kalau suatu saat ada data non-sensitif
    yang boleh dibackup (mis. preferensi tampilan), ganti <exclude> di bawah dengan
    <include> yang spesifik.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
